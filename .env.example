# HostelSOS Environment Configuration Template
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database (MongoDB Atlas or Local MongoDB)
# Leave as default or specify your MongoDB Atlas connection string:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/hostelsos?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/hostelsos

# JWT Secret Keys
JWT_SECRET=hostelsos_production_jwt_secret_super_secure_key_2026
JWT_REFRESH_SECRET=hostelsos_refresh_jwt_token_secret_key_2026
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# SMS Provider Adapter (Twilio / MSG91) - Optional
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE=

# Email Provider Adapter (Nodemailer / SMTP / Amazon SES) - Optional
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="HostelSOS Control Room <emergency@hostelsos.internal>"

# WhatsApp Business Cloud API - Optional
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=

# Web Push Notification Keys (VAPID) - Optional
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
